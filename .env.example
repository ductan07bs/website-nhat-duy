# ─────────────────────────────────────────────────────────────
# Mẫu biến môi trường cho chatbox AI — Nội Thất Nhật Duy
# Chạy thử trên máy: copy file này thành ".env" rồi điền giá trị thật.
# Trên Vercel: Project → Settings → Environment Variables (nhập từng biến).
# KHÔNG commit file .env (đã chặn trong .gitignore).
# ─────────────────────────────────────────────────────────────

# Nhà cung cấp AI: anthropic (mặc định) | gemini | openai
PROVIDER=anthropic

# Tên model. Để trống = dùng mặc định của provider (anthropic: claude-opus-5-5).
# Muốn rẻ hơn nhiều với Anthropic: MODEL=claude-haiku-5-5
MODEL=

# Khóa API — chỉ cần khóa của provider đang dùng
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=

# Trần token cho mỗi câu trả lời của AI (tùy chọn, mặc định 2000)
CHAT_MAX_TOKENS=

# URL Web App của Google Apps Script (xem hướng dẫn trong google-apps-script.gs)
SHEET_ENDPOINT=

# Telegram: token từ @BotFather, chat id từ @userinfobot
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
